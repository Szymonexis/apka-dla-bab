{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ogarniaczka",
  "version": "0.2.0",
  "identifier": "pl.apka.ogarniaczka.svelte",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ogarniaczka",
        "width": 420,
        "height": 880
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
