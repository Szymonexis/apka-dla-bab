# Skopiuj do .env i zmień wartości (szczególnie na produkcji!)
POSTGRES_USER=baba
POSTGRES_PASSWORD=baba
POSTGRES_DB=apka

JWT_SECRET=dev-secret-zmien-mnie

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=apka-files

# Adres serwera ntfy WIDZIANY Z TELEFONU (do subskrypcji w aplikacji ntfy).
# Na tej samej sieci Wi-Fi: http://<IP-komputera>:8090
NTFY_PUBLIC_URL=http://localhost:8090

# Strefa czasowa porannych podsumowań obowiązków
TIMEZONE=Europe/Warsaw
